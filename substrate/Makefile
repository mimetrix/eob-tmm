# substrate/Makefile — verification only. There is nothing to build here: this
# directory holds the two candidate ABI artifacts, not a program.
#
#   make check    syntax-check shield_abi.h (incl. its wire-layout asserts) and
#                 validate hook-point-map.json against the schema.
#
# See README.md for what is real vs. illustrative.

CC     ?= cc
PYTHON ?= python3

.PHONY: check check-header check-schema check-offsets check-budget check-gates \
        check-geometry check-shields check-stack check-vm check-tramp check-fexit check-arm check-swap \
        check-selfpatch check-ring check-tp check-tp-ring check-drain check-pads check-alpn check-rst check-json check-tramp-mirror check-map check-glue check-hook-map check-ls-load check-sslerr check-h2abort check-ctx-reg check-vendor-pin check-prereqs check-sig check-audit shield-blob gate clean

# THE FIRST THING `check` DOES IS SAY WHETHER IT CAN RUN. Measured on a fresh clone 2026-08-20:
# four targets failed on `fatal error: ubpf.h: No such file or directory`, three screens below
# forty "ok" lines, because uBPF and PREVAIL are vendored and gitignored --- present on every
# machine this was developed on, absent on every machine it would be reproduced on. Nothing here
# could notice, since everything that would notice was running where they existed.
#
# A raw compiler error at the bottom of a long log is indistinguishable from a broken change. This
# target names the missing prerequisite and the one command that fixes it, BEFORE anything else
# runs. It does not attempt to fetch anything: a check that silently mutates the tree it is
# checking is worse than a check that fails.
# WHERE ubpf_config.h IS, cmake decides; FINDING it is this Makefile's job. check-glue always
# located it with `find`; check-vm hardcoded ../ubpf/vm and worked here
# only because this tree had once been configured in-source, leaving a second copy at that path.
# On a clean clone `cmake -S . -B build` writes only build/vm, so the hardcoded path was wrong and
# the error --- "ubpf_config.h: No such file or directory" --- read as a missing dependency rather
# than a wrong include path. Two spellings of one lookup is how that survived; there is now one.
check-prereqs:
	@ok=1; \
	 [ -f ../ubpf/vm/inc/ubpf.h ]          || { echo "MISSING  ../ubpf/vm/inc/ubpf.h  (uBPF source)"; ok=0; }; \
	 [ -f ../ubpf/build/vm/ubpf_config.h ] || { echo "MISSING  ../ubpf/build/vm/ubpf_config.h  (GENERATED by cmake --- cloning uBPF is not enough)"; ok=0; }; \
	 if [ $$ok -eq 1 ]; then \
	   echo "ok    vendored prerequisites present (uBPF headers + generated config)"; \
	 else \
	   echo ""; \
	   echo "*** This clone cannot run three of its own checks: check-vm,"; \
	   echo "    check-map and check-glue compile against uBPF's real API, and uBPF is"; \
	   echo "    vendored and gitignored --- so a fresh clone does not have it."; \
	   echo ""; \
	   echo "    Fix, from the repository root:   ./bootstrap.sh"; \
	   echo ""; \
	   echo "    It clones uBPF and PREVAIL at the revisions substrate/vendor.pins names,"; \
	   echo "    from source, verifies them with check_vendor_pin.sh, and configures uBPF"; \
	   echo "    so the generated header exists. Nothing prebuilt is downloaded."; \
	   exit 1; \
	 fi

check: check-prereqs check-header check-schema check-offsets check-budget check-gates \
       check-geometry check-shields check-stack check-vm check-tramp check-fexit check-arm check-swap \
       check-selfpatch check-ring check-tp check-tp-ring check-drain check-pads check-alpn check-rst check-json check-tramp-mirror check-map check-glue check-hook-map check-ls-load check-sslerr check-h2abort check-audit check-ctx-parse check-alpn-get check-build-gate

# The header must compile standalone, be include-guard clean, and its
# _Static_asserts on struct shield_msg's layout must hold.
check-header:
	@$(CC) -fsyntax-only -x c shield_abi.h && echo "ok    shield_abi.h  (syntax)"
	@printf '#include "shield_abi.h"\n#include "shield_abi.h"\nint main(void){return (int)sizeof(struct shield_msg);}\n' > .guard.c
	@$(CC) -I. -o .guard.out .guard.c && echo "ok    shield_abi.h  (include guard + wire-layout asserts)"
	@rm -f .guard.c .guard.out

check-schema:
	@$(PYTHON) -m json.tool hook_map.schema.json > /dev/null && echo "ok    hook_map.schema.json  (valid JSON)"
	@$(PYTHON) ./check_hook_map.py

# The check a real hook-map generator must have: compile the map's declared ctx
# offsets against the actual header and fail on mismatch. Offsets are verified,
# not trusted — see the note at the top of check_offsets.py for the live bug in
# this repo that this catches.
check-offsets:
	@$(PYTHON) ./check_offsets.py

# The budget pass, over its own self-test cases: hand-assembled eBPF in a
# synthesized ELF, covering lddw's 16-byte form, longest-path over a branch, a
# fail-closed budget, and refusing a loop rather than guessing its trip count.
check-budget:
	@$(PYTHON) ./budget_pass.py

# The safe-return two-gate rule, asserted rather than documented: an unanalysed
# body must never be enforce-capable, whatever its return type. See F3 in
# ../../design-review-findings.md for the review that caught the inverted model.
check-gates:
	@$(CC) -I. -o .gates.out check_sr_gates.c && ./.gates.out; rc=$$?; rm -f .gates.out; exit $$rc

# Item 6a: does the verifier's model of the runtime match the runtime? Parsed
# from the two vendored trees at run time rather than transcribed. Reports;
# `make gate` is the same check with the exit code a build pipeline needs.
check-geometry:
	@$(PYTHON) ./check_vm_geometry.py

# Item 6a's resolution: the stack-usage calculator that makes uBPF allocate what
# PREVAIL proved against. Asserts the behaviour that matters — it must never return
# 0, because uBPF's header says 0 means "assume the maximum" and its code gives a
# zero-byte frame.
check-stack:
	@$(CC) -fsyntax-only -x c vm_stack_policy.h && echo "ok    vm_stack_policy.h  (syntax + _Static_asserts)"
	@printf '#include "vm_stack_policy.h"\n#include "vm_stack_policy.h"\n#include <assert.h>\nint main(void){\n struct vm_stack_policy g={256,8},bad0={0,8},mis={100,8},deep={512,9};\n assert(vm_stack_policy_valid(&g)); assert(!vm_stack_policy_valid(&bad0));\n assert(!vm_stack_policy_valid(&mis)); assert(!vm_stack_policy_valid(&deep));\n assert(!vm_stack_policy_valid(0));\n assert(vm_stack_usage(0,0,&g)==256);\n assert(vm_stack_usage(0,0,0)==512);\n assert(vm_stack_usage(0,0,&bad0)==512);\n assert(vm_stack_align_up(1)==16&&vm_stack_align_up(16)==16&&vm_stack_align_up(17)==32);\n return 0;}\n' > .vsp.c
	@$(CC) -I. -o .vsp.out .vsp.c && ./.vsp.out && echo "ok    vm_stack_policy.h  (9 assertions, incl. never-return-0)"
	@rm -f .vsp.c .vsp.out

# The embedded VM itself: the ~120 lines that make "TMM has its own BPF VM" true.
# Compiled against the REAL vendored uBPF headers, so a signature drift upstream
# fails here rather than at integration time. Compiled, not linked or run.
check-vm: shield-blob
	@CFG=$$(dirname $$(find ../ubpf -name ubpf_config.h | head -1)); \
	 $(CC) -fsyntax-only -Wall -Wextra -I. -I../ubpf/vm/inc -I "$$CFG" ls_vm.c \
	  && echo "ok    ls_vm.c  (compiles against the real uBPF API, -Wall -Wextra clean)"
	@$(CC) -fsyntax-only -Wall -Wextra -I. ls_vm_config.c \
	  && echo "ok    ls_vm_config.c  (stands alone, no uBPF headers needed)"
	@CFG=$$(dirname $$(find ../ubpf -name ubpf_config.h | head -1)); \
	 $(CC) -fsyntax-only -Wall -Wextra -I. -I../ubpf/vm/inc -I "$$CFG" ls_vm_load.c \
	  && echo "ok    ls_vm_load.c  (runtime load path; compiles against the real ABI)"

# The patched-entry trampoline. The .S is x86-64 only, so it is assembled where
# the assembler can take it and skipped loudly elsewhere --- this sandbox is
# aarch64, which is exactly the kind of thing that otherwise reports success by
# never running.
check-tramp:
	@$(CC) -fsyntax-only -Wall -Wextra -I. ls_tramp.c \
	  && echo "ok    ls_tramp.c  (the per-hook C half; arch-generic)"
	@if [ "$$(uname -m)" = "x86_64" ]; then \
	  $(CC) -O1 -I. -o .tramp.out check_tramp.c ls_tramp.c ls_fexit.c trampoline_x86_64.S victim.S 2>/dev/null && \
	  ./.tramp.out >/dev/null && \
	  echo "ok    trampoline_x86_64.S  (patched a stand-in entry; body runs on fall-through, skipped on safe return)" && \
	  rm -f .tramp.out; \
	else \
	  echo "skip  trampoline_x86_64.S  (host is $$(uname -m), not x86_64; assembly cannot run here)"; \
	fi

# The function-EXIT trampoline: return-address hijack + a shadow stack keyed by
# the stack pointer, with reclaim of returns a non-local exit skipped. The .S is
# x86-64 only. check_fexit.c arms four stand-ins and asserts capture, caller
# transparency, nested LIFO, recursion, and the longjmp-reclaim path.
check-fexit:
	@$(CC) -fsyntax-only -Wall -Wextra -I. ls_fexit.c \
	  && echo "ok    ls_fexit.c  (the shadow stack; arch-generic C half)"
	@if [ "$$(uname -m)" = "x86_64" ]; then \
	  $(CC) -O2 -fcf-protection=branch -I. -o .fexit.out check_fexit.c ls_fexit.c ls_tramp.c trampoline_x86_64.S fexit_victims.S 2>/dev/null && \
	  ./.fexit.out >/dev/null && \
	  echo "ok    ls_fexit_x86_64.S  (armed a stand-in exit; return captured, caller transparent, nesting/recursion synced, skipped return reclaimed)" && \
	  rm -f .fexit.out; \
	else \
	  echo "skip  ls_fexit_x86_64.S  (host is $$(uname -m), not x86_64; assembly cannot run here)"; \
	fi

# Arming: write the patch into live code and take it back out. Runs the real
# thing --- maps an executable page near the trampoline, arms a hand-built target,
# calls it, disarms it --- on x86_64; skips loudly elsewhere.
check-arm:
	@if [ "$$(uname -m)" = "x86_64" ]; then \
	  $(CC) -O2 -fcf-protection=branch -c ls_arm.c -o .ls_arm.o && \
	  $(CC) -O2 -fcf-protection=branch -c test_tramp.S -o .tt.o && \
	  $(CC) -O2 -fcf-protection=branch -o .arm.out check_arm.c .ls_arm.o .tt.o && \
	  ./.arm.out >/dev/null && \
	  echo "ok    ls_arm.c  (armed a live function: patch installed, both verdicts, reversed)" && \
	  rm -f .ls_arm.o .tt.o .arm.out; \
	else \
	  echo "skip  ls_arm.c  (host is $$(uname -m), not x86_64; cannot execute the patch)"; \
	fi

# The safe swap: prove the naive patch races and the text_poke_bp protocol does
# not, under multi-core stress. x86_64 only; needs membarrier(SYNC_CORE).
check-swap:
	@if [ "$$(uname -m)" = "x86_64" ]; then \
	  $(CC) -O2 -fcf-protection=branch -c test_tramp.S -o .tt.o && \
	  $(CC) -O2 -fcf-protection=branch -pthread -o .swap.out check_swap.c .tt.o && \
	  ./.swap.out 8 3 5000 0 >/dev/null && ./.swap.out 8 3 5000 2 >/dev/null && \
	  echo "ok    check_swap.c  (naive swap races under stress; text_poke_bp clean)" && \
	  rm -f .tt.o .swap.out; \
	else \
	  echo "skip  check_swap.c  (host is $$(uname -m); needs x86_64 + multi-core)"; \
	fi

# The candidate shields in shields/, compiled and put to PREVAIL, with each verdict
# asserted. A rejection program that starts passing is the dangerous direction, so both
# directions are failures. Skips loudly if clang has no BPF target or prevail is unbuilt.
check-shields:
	@$(PYTHON) ./check_shields.py

# The hook map (scope item 5, phase A): every function's entry address and whether
# it really carries an arming pad, read from the binary. Needs the DEB PAIR, which
# lives on the build box -- packaging re-links the binary, so the build tree's
# addresses are not the pod's. Skips loudly rather than silently passing.
DEBS ?= $(HOME)/code/tmm/docker_build/DEBS/amd64
# Arming by NAME, and the build-id gate under it. On 2026-08-17 a stale hex address
# armed the function 64 bytes past rst_why -- which also carries a nop pad, so the
# patch succeeded, OK ARMED LIVE was printed, and fired stayed 0 through 16,000
# requests. A pad cannot distinguish itself from another pad; a build id can. Most
# of these assertions are REFUSALS, because a resolver that fell back to something
# plausible would reproduce that bug with extra steps.
check-ls-load:
	@python3 check_ls_load.py

check-hook-map:
	@if [ -d "$(DEBS)" ] && ls $(DEBS)/tmm_*.deb >/dev/null 2>&1; then \
	  $(PYTHON) ./mk_hook_map.py --debs "$(DEBS)" -o .hookmap.json 2>/dev/null && \
	  rm -rf .hmx && mkdir -p .hmx/b .hmx/d && \
	  dpkg-deb -x $$(ls $(DEBS)/tmm_*.deb | head -1) .hmx/b && \
	  dpkg-deb -x $$(find $(DEBS) -name 'tmm-debuginfo_*.deb' | head -1) .hmx/d && \
	  $(PYTHON) ./check_hook_map_addrs.py --map .hookmap.json \
	     --binary .hmx/b/usr/bin/tmm64.no_pgo \
	     --debuginfo .hmx/d/usr/lib/debug/usr/bin/tmm64.no_pgo.debug >/dev/null && \
	  echo "ok    hook map  ($$($(PYTHON) -c 'import json;print(f"{len(json.load(open(".hookmap.json"))["hook_points"]):,}")') entries, pads verified against the binary)" && \
	  rm -rf .hmx .hookmap.json; \
	else \
	  echo "skip  hook map  (no deb pair under $(DEBS); run on the build box)"; \
	fi

# The egress ring: the four properties that cannot be tested inside TMM, because
# reaching them there means engineering a stalled consumer and a full ring, and a
# wrong answer looks like "records are occasionally odd" inside a poll loop.
# STREAM drop-and-count, RECORD overwrite-oldest, SPSC exactness, wraparound.
# The designed-in tracepoint record (ls_tp_http.h). Compiles the builder against
# MOCK TMM structs -- the real ones live in TMM's -nostdinc world and are not here
# -- and pins the layout both the host and the eBPF program depend on. Cannot
# prove the field names match TMM's; only the TMM build does that, which is why
# the flags are composed by name rather than masked out of a byte offset.
check-tp:
	@$(CC) -O2 -Wall -Wextra -Werror -o .tp.out check_tp.c && ./.tp.out && rm -f .tp.out

# The tracepoint's shared-memory SEGMENT --- the part check_ring.c does not cover.
# ls_ring.h is the ring and was already proven; this is the segment around it:
# geometry a consumer can navigate, a DISTINCT ring per thread (ls_ring is
# single-producer, which is correctness not tuning), and a SECOND MAPPING reading
# the records, since the drain agent is another process sharing only these bytes.
# THE GOVERNING CONSTRAINT: TMM must not depend on the drain agent -- not on it
# running, keeping up, exiting cleanly, or behaving. Drives a producer through
# four consumer behaviours (absent / crashed / stalled / healthy) plus a hostile
# consumer_pos, and measures MAX SINGLE-EMIT LATENCY. Back-pressure would appear
# there and nowhere else; record counts alone would not prove it.
# BOTH pad shapes. check_arm.c executes a real patch so it is x86_64-only; the
# decision about WHERE the five bytes are is pure byte matching and must be tested
# everywhere, because getting it wrong writes a call over a live instruction.
# The drift guard matters as much as the assertions: check_pad_shapes.c mirrors
# ls_arm.c, and a mirrored test that has drifted reports confidence it has not
# earned.
# The ALPN shield and its host builder, run against the exact payloads
# alpn_trigger.py emits. Neither half can be exercised on the cluster until a TLS
# listener exists, so this is where they are proven to AGREE -- two halves in
# different languages, different compilers, different targets. The control
# matters as much as the catch: real ALPN must fall through, or arming this in
# enforce breaks TLS for everyone.
# The reset record. The builder runs on a TEARDOWN path, where state is already
# unusual and a faulting tracepoint does the most damage -- so the guards are
# asserted, and the boundary cases (no slash, trailing slash, over-long name) are
# the ones that would produce plausible wrong output rather than obvious failure.
# Maps -- state that survives between invocations. PREVAIL proves the program
# passed a map descriptor and reads at most value_size bytes; it cannot prove the
# HOST resolves an index to a map of that shape, nor that the bounds callback is
# right. Both are ours. The REFUSALS matter more than the successes: a descriptor
# we cannot honour must be rejected, never clamped, or the verifier has proved
# bounds for a shape we do not enforce.
# The five uBPF registrations that make maps work were LOST once, silently ---
# they existed only in the build box's tree and a repo copy overwrote them. The
# programs still loaded, verified and ran; their maps were just always empty.
# check-glue links two TUs against the glue and asserts the sequence, so losing
# it again is a test failure rather than a live result that quietly means nothing.
# The agent emitted string fields with a bare %s until Phase 3, which was safe only
# because the one string in a record was a __FILE__ basename. Forwarding rst_why's
# cause string makes escaping load-bearing, and a broken escaper fails in the
# CONSUMER, not here. Asserted, then piped through a real JSON parser --- a
# hand-written escaper passing a hand-written test proves little alone.
# ls_tramp_asm.c is the .S wrapped for a C-only filelist. Nothing regenerated it, so
# on 2026-08-17 Phase 3 landed in the .c and not the .S --- the two disagreed and any
# future regeneration would have silently reverted the change. Compare them.
tramp-asm:
	@python3 mk_tramp_asm.py

check-tramp-mirror:
	@cp ls_tramp_asm.c .tramp_ref.c && python3 mk_tramp_asm.py >/dev/null && \
	 if cmp -s ls_tramp_asm.c .tramp_ref.c; then \
	   rm -f .tramp_ref.c; echo "ok    ls_tramp_asm.c matches trampoline_x86_64.S"; \
	 else \
	   mv .tramp_ref.c ls_tramp_asm.c; \
	   echo "FAIL  ls_tramp_asm.c has DRIFTED from trampoline_x86_64.S --- run make tramp-asm"; \
	   exit 1; \
	 fi

check-json:
	@$(CC) -O2 -Wall -Wextra -Werror -I. -o .json.out check_json.c && ./.json.out && rm -f .json.out
	@$(CC) -O2 -I. -DLS_JSON_DUMP -o .jd.out check_json.c 2>/dev/null && ./.jd.out > .j.jsonl && \
	 python3 -c "import json;[json.loads(l) for l in open('.j.jsonl') if l.strip()];print('ok    ls_json.h  every escaped line round-trips through python json.loads')" && \
	 rm -f .j.jsonl .jd.out

check-glue:
	@CFG=$$(dirname $$(find ../ubpf -name ubpf_config.h | head -1)); \
	 $(CC) -O2 -Wall -Wextra -I. -I ../ubpf/vm/inc -I "$$CFG" -o .glue.out \
	   check_glue_owner.c check_glue_user.c check_glue_stubs.c \
	 && ./.glue.out && rm -f .glue.out

check-map:
	@$(CC) -O2 -Wall -Wextra -Werror -o .map.out check_map.c && ./.map.out && rm -f .map.out
	@CFG=$$(dirname $$(find ../ubpf -name ubpf_config.h | head -1)); \
	 $(CC) -fsyntax-only -Wall -Wextra -Werror -I. -I ../ubpf/vm/inc -I "$$CFG" ls_map_glue.h \
	 && echo "ok    ls_map_glue.h  (3 uBPF callbacks; helper signatures match external_function_t)"

# The ssl__err record --- the TLS twin of the reset record. Same class of risk and
# therefore the same class of test: it runs on TLS error paths where a faulting builder
# does the most damage, and the cases that matter are the ones producing PLAUSIBLE WRONG
# OUTPUT rather than obvious failure. An over-long __func__ cut without the length saying
# so, one NULL pointer costing the other field, a string bleeding in from the previous
# record. The size assertion is load-bearing: this record is 96 bytes, which is AT
# PREVAIL's measured ctx ceiling, so growing either array must fail at BUILD time rather
# than later at verification with a message about a program.
# The HTTP/2 stream-abort record --- the one hook of the four whose reason reaches no log,
# no iRule event and no trace in a production build. The stream-id assertions are specific
# to it: the id is FOLDED from the pointer, so it must be stable per stream (or you cannot
# group by stream), distinct for a neighbouring allocation (or unrelated aborts group and
# you conclude one stream is failing), and not either half of the address (or a host
# address reaches a telemetry stream).
check-h2abort:
	@$(CC) -O2 -Wall -Wextra -Werror -o .h2a.out check_h2abort.c && ./.h2a.out && rm -f .h2a.out

check-sslerr:
	@$(CC) -O2 -Wall -Wextra -Werror -o .sslerr.out check_sslerr.c && ./.sslerr.out && rm -f .sslerr.out

check-rst:
	@$(CC) -O2 -Wall -Wextra -Werror -o .rst.out check_rst.c && ./.rst.out && rm -f .rst.out

check-alpn:
	@$(CC) -O2 -Wall -Wextra -Werror -o .alpn.out check_alpn.c && ./.alpn.out && rm -f .alpn.out

check-pads:
	@$(CC) -O2 -Wall -Wextra -Werror -o .pads.out check_pad_shapes.c && ./.pads.out && rm -f .pads.out
	@$(PYTHON) ./check_pad_drift.py

check-drain:
	@$(CC) -O2 -Wall -Wextra -Werror -pthread -o .drain.out drain/check_drain.c && ./.drain.out && rm -f .drain.out
	@$(CC) -O2 -Wall -Wextra -Werror -o .lsd.out drain/ls_drain.c \
	  && echo "ok    ls_drain.c  (the agent itself compiles, -Wall -Wextra clean)" && rm -f .lsd.out

check-tp-ring:
	@$(CC) -O2 -Wall -Wextra -Werror -pthread -o .tpr.out check_tp_ring.c && ./.tpr.out && rm -f .tpr.out

check-ring:
	@$(CC) -O2 -Wall -Wextra -Werror -pthread -o .ring.out check_ring.c && ./.ring.out >/dev/null \
	  && echo "ok    ls_ring.h  (15 assertions: SPSC exact, both full-policies, wraparound)" \
	  && rm -f .ring.out

# The built-in shield, as bytes. ls_vm_load.c includes this and arms it at
# startup; it is generated, so it is not committed. check-vm depends on it --
# without it the loader does not compile at all.
shield-blob:
	@$(PYTHON) ./mk_shield_blob.py

# Can a process patch its OWN private r-xp .text so EXECUTION sees the change?
# This is the gate the whole patched-entry mechanism rests on (bnk-integration-map.md
# section 2), and it was not wired into `check` until 2026-08-14. Tests the only way
# that counts: write 0xcc into a real function's pad via /proc/self/mem, then CALL it
# and see whether it traps. A control run with no write must NOT trap, so a passing
# result cannot be an ambient signal.
check-selfpatch:
	@if [ "$$(uname -m)" = "x86_64" ]; then \
	  $(CC) -O2 -fcf-protection=branch -o .sp.out check_selfpatch.c && \
	  ./.sp.out >/dev/null && \
	  echo "ok    check_selfpatch.c  (own r-xp .text patched; execution sees it; control clean)" && \
	  rm -f .sp.out; \
	else \
	  echo "skip  check_selfpatch.c  (host is $$(uname -m), not x86_64)"; \
	fi

# Everything in `check`, plus the standing findings turned fatal. This is what a
# real admission pipeline would run. It FAILS today, on purpose: item 6a is open.
gate: check
	@$(PYTHON) ./check_vm_geometry.py --gate

clean:
	@rm -f .guard.c .guard.out .gates.out tmp*.c
	@rm -rf __pycache__

# THE CTX BUILDER REGISTRATION SET. Each builder registers itself against the function name
# it serves (ls_ctx_reg.h); the trampoline no longer switches on the slot number, which is
# what let an arbitrary function's registers be read as rst_why's arguments.
#
# Links the real registration TUs, so this fails if the linker drops the ls_ctx_regs section
# --- the failure mode that would otherwise be silent, safe, and cost a day: every typed hook
# degrades to the generic ctx and the record feeds just stop.
#
# The stubs supply the TMM-side cookie and ALPN functions and register nothing, because the
# check compares the linked count against the number of LS_CTX_REGISTER uses in the sources.
check-ctx-reg:
	@$(CC) -O2 -Wall -Wextra -Werror -o .ctxreg.out \
	    check_ctx_reg.c ls_ctx_reg.c ls_ctx_reg_rst.c ls_ctx_reg_sslerr.c \
	    ls_ctx_reg_h2abort.c ls_ctx_reg_parse.c ls_ctx_reg_alpn.c check_ctx_reg_stubs.c \
	    && ./.ctxreg.out . && rm -f .ctxreg.out

# THE BORROWED CODE IS WHAT WE SAY IT IS. Four documents recorded the uBPF and PREVAIL
# provenance and disagreed with each other and with the tree --- one claiming the revision
# "cannot be stated" while the checkout carried git history all along. A prose pin drifts
# because nothing compares it to anything.
check-vendor-pin:
	@sh check_vendor_pin.sh

# SIGNATURE VERIFICATION, attacked before it is believed. 02-RESEARCH-PARAMETERS.md P6
# pre-registered five ways this could be worthless; check_sig.c is those five, executable.
#
# BOTH CONFIGURATIONS ARE RUN. A keyed build must admit a good program and refuse every tampered
# one; a KEYLESS build must refuse even a good one, because that is the correct default for a
# tree nobody configured. Testing only the keyed case would leave the fail-closed default
# unverified, which is the half that matters if someone forgets to generate a key.
#
# -I$$T PRECEDES -I. and the order is load-bearing: the generated key header must win over the
# one committed in this directory. With -I. first, the test signed with a fresh key and verified
# against the checked-in one --- and reported a failure of its own construction, which is the
# most confusing possible way for a security test to fail.
# THE AUDIT TRAIL, ATTACKED. check_audit.c is the list of ways a record could be wrong, executed:
# forged by log injection, silently truncated, missing for malformed input, disagreeing with the
# reply the caller got, or naming a build that is not the one running.
#
# --build-id IS REQUIRED and is not decoration. ls_audit.c reads this binary's GNU build-id note
# to record WHICH BINARY performed an operation, matching the string the arming gate compares.
# Without the flag the test binary has no note, the parse goes untested, and A8 fails rather than
# skipping --- an unexercised ELF parse inside an audit trail is not a pass.
check-audit:
	@$(CC) -O2 -Wall -Wextra -Werror -I. -Wl,--build-id -o .audit.out \
	    check_audit.c ls_audit.c
	@./.audit.out >/dev/null 2>&1 && echo "ok    ls_audit.c  (21 assertions: injection, truncation, peer creds, build id, op naming)" \
	  || { ./.audit.out; rm -f .audit.out; exit 1; }
	@rm -f .audit.out

# P9 (02-RESEARCH-PARAMETERS.md): before the embedded .BTF can be removed, the
# offsets baked at sign time must be shown correct. This re-implements the CO-RE
# relocation walk independently in Python and compares it to what ls_core_relo.c
# actually wrote into the object --- comparing the offline relocator to the on-box
# one would compare that file to itself.
#
# NEEDS THE TARGET BUILD'S BTF, which lives on the build box. Skipped loudly
# rather than silently on a clone that has none: a skipped check that looks like a
# pass is how the stale-artifact failures in this tree happened.
#   make check-relo-baked TMM_BTF=~/lstools/tmm.btf
TMM_BTF ?=
check-relo-baked:
	@if [ -z "$(TMM_BTF)" ] || [ ! -s "$(TMM_BTF)" ]; then \
	  echo "SKIP check-relo-baked --- no target BTF."; \
	  echo "     Pass TMM_BTF=<path to this build's tmm.btf> (build box:"; \
	  echo "     ~/lstools/tmm.btf, produced by env/scripts/bnk-bake-tools.sh)."; \
	  echo "     This is a SKIP, not a pass: sign-time baking is unverified without it."; \
	  exit 0; \
	fi; \
	set -e; T=$$(mktemp -d); trap 'rm -rf $$T' EXIT; \
	  cc -O2 -w -DLS_CORE_RELO_TEST ls_core_relo.c -o $$T/relo; \
	  O=""; for d in shields surfaces; do \
	    for f in $$d/*.bpf.c; do \
	      [ -e "$$f" ] || continue; b=$$(basename $$f .bpf.c); \
	      clang -O2 -g -target bpf -I. -c $$f -o $$T/$$b.bpf.o 2>/dev/null || continue; \
	      O="$$O $$T/$$b.bpf.o"; \
	    done; done; \
	  [ -n "$$O" ] || { echo "*** no program compiled --- nothing to check"; exit 1; }; \
	  python3 check_relo_baked.py "$(TMM_BTF)" $$O --relo $$T/relo

# The signed build range, compared to something for the first time.
# CONTESTED-PREMISES.md 15: the field was signed, tamper-tested and logged, and
# read by nothing. 18 assertions on the decision itself, off-TMM.
check-build-gate:
	@$(CC) -O2 -Wall -Wextra -Werror -I. -o .bgate.out check_build_gate.c
	@./.bgate.out >/dev/null 2>&1 && echo "ok    ls_build_gate.h  (18 assertions: prefix encoding, mismatch refused, hash range refused, fail-closed)" \
	  || { ./.bgate.out; rm -f .bgate.out; exit 1; }
	@rm -f .bgate.out

check-sig:
	@set -e; T=$$(mktemp -d); trap 'rm -rf $$T' EXIT; \
	  openssl genpkey -algorithm ed25519 -out $$T/sk.pem 2>/dev/null; \
	  openssl genpkey -algorithm ed25519 -out $$T/other.pem 2>/dev/null; \
	  openssl pkey -in $$T/sk.pem -pubout -out $$T/pk.pem 2>/dev/null; \
	  clang -O2 -g -target bpf -I. -c shields/rst_watch.bpf.c -o $$T/prog.o 2>/dev/null \
	    || cp shields/rst_watch.bpf.c $$T/prog.o; \
	  clang -O2 -g -target bpf -I. -c shields/demo_pass.bpf.c -o $$T/other.o 2>/dev/null \
	    || cp shields/demo_pass.bpf.c $$T/other.o; \
	  python3 sign_shield.py --key $$T/sk.pem --prog $$T/prog.o --hook rst_why \
	      -o $$T/signed.bin >/dev/null; \
	  python3 sign_shield.py --key $$T/other.pem --prog $$T/prog.o --hook rst_why \
	      -o $$T/wrong.bin >/dev/null; \
	  python3 gen_sig_pubkey.py $$T/pk.pem -o $$T/ls_sig_pubkey.h >/dev/null; \
	  $(CC) -O2 -Wall -Wextra -Werror -I$$T -I. -o $$T/keyed check_sig.c ls_sig.c -lcrypto; \
	  $$T/keyed $$T/signed.bin $$T/prog.o $$T/other.o $$T/wrong.bin; \
	  python3 gen_sig_pubkey.py --none -o $$T/ls_sig_pubkey.h >/dev/null; \
	  $(CC) -O2 -Wall -Wextra -Werror -I$$T -I. -o $$T/nokey check_sig.c ls_sig.c -lcrypto; \
	  LS_SIG_EXPECT_NOKEY=1 $$T/nokey $$T/signed.bin $$T/prog.o $$T/other.o

# ls_ctx_parse.h reaches into two TMM structs by hard-coded byte offset and its own banner said
# so --- "here it is silent if wrong" --- while pointing at a checking function that did not
# exist for months (CONTESTED-PREMISES.md 12). Two things run here:
#
#   the PREDICATE, executed, in both its gated and ungated forms; and
#   the OFFSETS, compared against real DWARF when a debuginfo is available.
#
# check_ctx_parse.py without --debuginfo verifies nothing and says so rather than passing
# quietly, which is the whole point of the entry it was written for. The bake supplies
# DEBUGINFO=<file> and should add --strict once TMM's real member names are filled in.
check-alpn-get:
	@$(CC) -O2 -Wall -Wextra -Werror -I. -o .alpnget.out check_alpn_get.c \
	  && ./.alpnget.out && rm -f .alpnget.out

check-ctx-parse:
	@$(CC) -g -O0 -w -o .ctxfix.out check_ctx_parse_fixture.c
	@$(PYTHON) ./mk_ctx_parse.py --debuginfo .ctxfix.out --cross-check \
	    -o ls_ctx_parse_offsets.h
	@$(CC) -O2 -Wall -Wextra -Werror -I. -o .ctxsane.out check_ctx_parse_sane.c \
	  && ./.ctxsane.out; rc=$$?; rm -f .ctxsane.out .ctxfix.out; exit $$rc
