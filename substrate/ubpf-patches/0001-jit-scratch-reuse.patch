+/*
+ * eob-tmm (F5 fork): JIT scratch reused across compiles.
+ *
+ * The five buffers below are sized by UBPF_MAX_INSTS (65536) irrespective of the
+ * program being compiled --- 5.25 MB in total. Reallocating them per compile
+ * costs ~272 us of demand paging on first touch, which measured as ~90% of
+ * ubpf_compile_ex for a 4 KB program (311 us median, 3187 us max). Allocating
+ * once and reusing leaves the pages resident, so subsequent compiles pay only
+ * for real compilation (~40 us).
+ *
+ * Reuse is safe because no entry is read before it is written within a compile:
+ * the patchable_relative tables are indexed by num_* counters that reset to 0
+ * here, and every pc_locs index read during fixup was written during
+ * translation.
+ *
+ * ls_jit_scratch_busy keeps this to one compile at a time; a concurrent second
+ * compile falls back to the original per-compile calloc, preserving upstream
+ * behaviour for callers we do not control.
+ */
+static uint32_t*                  ls_jit_pc_locs;
+static struct patchable_relative* ls_jit_jumps;
+static struct patchable_relative* ls_jit_loads;
+static struct patchable_relative* ls_jit_leas;
+static struct patchable_relative* ls_jit_local_calls;
+static int                        ls_jit_scratch_busy;
+
+/* Allocate once and fault every page in immediately, so the cost is paid here
+ * --- at startup, on whichever thread compiles first --- rather than inside a
+ * later latency-sensitive compile. Returns 0 on success. */
+static int
+ls_jit_scratch_init(void)
+{
+    if (ls_jit_pc_locs != NULL)
+        return 0;
+
+    ls_jit_pc_locs     = calloc(UBPF_MAX_INSTS + 1, sizeof(ls_jit_pc_locs[0]));
+    ls_jit_jumps       = calloc(UBPF_MAX_INSTS, sizeof(ls_jit_jumps[0]));
+    ls_jit_loads       = calloc(UBPF_MAX_INSTS, sizeof(ls_jit_loads[0]));
+    ls_jit_leas        = calloc(UBPF_MAX_INSTS, sizeof(ls_jit_leas[0]));
+    ls_jit_local_calls = calloc(UBPF_MAX_INSTS, sizeof(ls_jit_local_calls[0]));
+
+    if (!ls_jit_pc_locs || !ls_jit_jumps || !ls_jit_loads || !ls_jit_leas ||
+        !ls_jit_local_calls) {
+        free(ls_jit_pc_locs);     ls_jit_pc_locs = NULL;
+        free(ls_jit_jumps);       ls_jit_jumps = NULL;
+        free(ls_jit_loads);       ls_jit_loads = NULL;
+        free(ls_jit_leas);        ls_jit_leas = NULL;
+        free(ls_jit_local_calls); ls_jit_local_calls = NULL;
+        return -1;
+    }
+
+    /* Touch one byte per 4 KB page so the faults happen now, not during the
+     * first compile. calloc returns lazily-mapped zero pages; without this the
+     * first compile still pays the full ~272 us. */
+    {
+        volatile char* q;
+        size_t i;
+        q = (volatile char*)ls_jit_pc_locs;
+        for (i = 0; i < (UBPF_MAX_INSTS + 1) * sizeof(ls_jit_pc_locs[0]); i += 4096) q[i];
+        q = (volatile char*)ls_jit_jumps;
+        for (i = 0; i < UBPF_MAX_INSTS * sizeof(ls_jit_jumps[0]); i += 4096) q[i];
+        q = (volatile char*)ls_jit_loads;
+        for (i = 0; i < UBPF_MAX_INSTS * sizeof(ls_jit_loads[0]); i += 4096) q[i];
+        q = (volatile char*)ls_jit_leas;
+        for (i = 0; i < UBPF_MAX_INSTS * sizeof(ls_jit_leas[0]); i += 4096) q[i];
+        q = (volatile char*)ls_jit_local_calls;
+        for (i = 0; i < UBPF_MAX_INSTS * sizeof(ls_jit_local_calls[0]); i += 4096) q[i];
+    }
+    return 0;
+}
