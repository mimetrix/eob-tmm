# build output
build.log


# third-party clones (clone these yourself; see the Notes section of README.md)
ubpf/
ebpf-verifier/

# IP: invention/patent disclosures must never enter a shared repo
*Disclosure*.md
*disclosure*.md
*Invention*.md
*invention*.md


# AI-authored-shield-pipeline invention disclosure figures (IP — never in shared repo)
disclosure-figures/

# Credentials — must never enter a shared repo. Defensive only: the rule is to
# keep secrets outside the working tree entirely (OpenStack application
# credentials belong in ~/.config/openstack/clouds.yaml, mode 600), not to rely
# on these patterns. See env/README.md.
*clouds*.y*ml
*openrc*
*.pem
*.key
app-cred*
application-credential*

# macOS
.DS_Store

# python bytecode
__pycache__/
*.pyc

# send bundles (regenerate with git archive; never commit)
*.zip
SEND-NOTE.md

# Internal-document exports (Confluence PDF/Word downloads and the like).
# These carry internal hostnames, IPs, usernames and internal URLs, and this
# repo pushes to GitHub — off F5 infrastructure. Read them locally, write the
# operational facts into env/ in our own words, and let the export stay out.
*.pdf
*.docx
*Confluence*

# Credential files dropped into the working tree (the repo root is a host mount,
# so files land here from the desktop). Keep them out of git as a matter of course.
artifactory-token
*-token
*.token

# generated by substrate/mk_shield_blob.py
substrate/ls_shield_blob.h

# personal Claude Code permission rules --- not shared
.claude/settings.local.json
signatures.tsv
hook-index.tsv

# never commit a signing key --- it lives in ~/.ls-signing, outside the repo
*_sk.pem
*.sig
