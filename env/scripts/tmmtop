#!/usr/bin/env python3
"""tmmtop --- a coherent snapshot of TMM's internals, read from the loader socket.

    tmmtop                                     REFRESH until you stop it (like top)
    tmmtop -d 5                                refresh every 5s
    tmmtop -n 3                                three refreshes, then exit
    tmmtop --once                              one snapshot, no rates
    tmmtop --once --json                       one snapshot, machine-readable
    tmmtop --json                              one JSON object per tick (JSON Lines)
    tmmtop --label 5=loop --label 4=cve_shield name the columns

Default behaviour is CONTINUOUS, because that is what makes it top rather than a snapshot tool:
each tick diffs against the PREVIOUS tick, so the rates are a moving picture rather than one
interval. Ctrl-C stops it and exits 0 --- interrupting a monitor is not an error.

WHY THIS IS THE SNAPSHOT LAYER AND NOT THE UI. The interesting logic here is delta arithmetic,
rate computation and slot->column mapping. None of it needs a terminal, and all of it is worth
testing, so it lives in a layer with no curses in it. A refreshing UI and a Prometheus exporter
are both thin consumers of `--json`.

WHY IT MUST RUN INSIDE THE f5-tmm CONTAINER. The loader socket is /tmp/ls_load.sock.<n> in that
container. Sampling over `kubectl exec` costs 100-300 ms per read, so six columns at a 1 s refresh
cannot keep up --- and worse, the samples are taken at different instants, which silently corrupts
every delta computed across them. In-container, a snapshot is a handful of local reads.

WHY IT SHELLS OUT TO ls-load.py RATHER THAN SPEAKING THE PROTOCOL ITSELF. The framing is already
implemented and tested there, including the socket-name suffix problem (LS_LOAD_SOCKET=/tmp/
ls_load.sock becomes /tmp/ls_load.sock.24, and connecting to the unsuffixed name fails with ENOENT
that reads exactly like "the loader is off"). A second parser is a second place to get that wrong
--- see engine-hard-problems 4.1 on the loader being a second parser. The cost is one fork per
slot, ~ms locally, which is coherent enough at a 1 s refresh. If that ever stops being true, the
upgrade is to import ls-load.py as a module, not to re-implement it.

WHAT IT DOES NOT KNOW. `status` returns counters, NOT which hook a slot is armed at. So a column's
MEANING cannot be discovered --- it has to be declared with --label. That is stated rather than
guessed: an unlabelled slot is reported as its number, never as an assumption about what is in it.
"""
import argparse, json, os, shutil, subprocess, sys, time

FIELDS = ("armed", "mode", "gen", "fired", "safe_returns", "errors",
          "cycles", "cycles_max", "cycles_min")
# Counters that accumulate, so a delta between samples is meaningful. `cycles_min`/`cycles_max`
# are envelopes, not accumulators --- differencing them would be nonsense, so they are reported
# as observed values and excluded from the rate table.
COUNTERS = ("fired", "safe_returns", "errors", "cycles")


def find_loader():
    for c in ("/usr/bin/ls-load.py", "ls-load.py"):
        p = shutil.which(c) or (c if os.path.exists(c) else None)
        if p:
            return p
    sys.exit("tmmtop: cannot find ls-load.py --- run this INSIDE the f5-tmm container")


def read_slot(loader, slot):
    """One slot's counters, or None if the slot is empty/unreadable. Never guesses a value."""
    try:
        out = subprocess.run([loader, "status", str(slot)], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception as e:
        return {"error": "%s: %s" % (type(e).__name__, e)}
    if "OK" not in out:
        return {"error": out.strip()[:120] or "no response"}
    d = {}
    for tok in out.split():
        if "=" in tok:
            k, _, v = tok.partition("=")
            if k in FIELDS:
                try:
                    d[k] = int(v)
                except ValueError:
                    d[k] = v
    return d or {"error": "unparsed: " + out.strip()[:80]}


def sample(loader, slots):
    """A snapshot. `mono` is taken once around the whole read so rates share one clock."""
    t0 = time.monotonic()
    slotd = {str(s): read_slot(loader, s) for s in slots}
    t1 = time.monotonic()
    return {"mono": (t0 + t1) / 2.0, "read_span_s": round(t1 - t0, 4),
            "wall": time.time(), "slots": slotd}


def rates(a, b, labels):
    """Per-second rates from two samples. Reports the span so a consumer can judge the sample."""
    dt = b["mono"] - a["mono"]
    out = {"interval_s": round(dt, 4), "read_span_s": b["read_span_s"], "slots": {}}
    if dt <= 0:
        out["error"] = "non-positive interval"
        return out
    for s, bs in b["slots"].items():
        as_ = a["slots"].get(s, {})
        row = {"label": labels.get(s, s)}
        if "error" in bs or "error" in as_:
            row["error"] = bs.get("error") or as_.get("error")
        else:
            row["armed"] = bs.get("armed")
            row["mode"] = bs.get("mode")
            if bs.get("gen") != as_.get("gen"):
                # A reload resets counters; a delta across it is meaningless. Say so.
                row["error"] = "gen changed %s->%s (reloaded mid-sample)" % (as_.get("gen"), bs.get("gen"))
            else:
                for c in COUNTERS:
                    if c in bs and c in as_:
                        delta = bs[c] - as_[c]
                        if delta < 0:
                            # A COUNTER WENT BACKWARDS WITHOUT `gen` MOVING, which this
                            # tool cannot model. It should not happen: counters accumulate
                            # and survive a reload (only `gen` increments), and a pod
                            # replacement resets `gen` too, so that case is caught above.
                            # Something else did it. A negative rate printed as fact is
                            # worse than saying so --- the whole point of the rate table
                            # is that a reader can trust the numbers in it.
                            row["error"] = ("%s went backwards %d->%d with gen unchanged"
                                            % (c, as_[c], bs[c]))
                            break
                        row[c + "_per_s"] = round(delta / dt, 2)
                for e in ("cycles_min", "cycles_max"):
                    if e in bs:
                        row[e] = bs[e]
        out["slots"][s] = row
    return out


def render(snap, labels, is_rate):
    lines = []
    if is_rate:
        lines.append("tmmtop  interval=%ss  read_span=%ss" % (snap["interval_s"], snap["read_span_s"]))
        lines.append("%-14s %5s %4s %12s %12s %10s %10s" %
                     ("SLOT", "ARMED", "MODE", "FIRED/s", "MATCH/s", "CYC_MIN", "CYC_MAX"))
        for s in sorted(snap["slots"], key=lambda x: int(x)):
            r = snap["slots"][s]
            if "error" in r:
                lines.append("%-14s %s" % (r["label"], r["error"]))
                continue
            lines.append("%-14s %5s %4s %12s %12s %10s %10s" % (
                r["label"], r.get("armed", "-"), r.get("mode", "-"),
                r.get("fired_per_s", "-"), r.get("safe_returns_per_s", "-"),
                r.get("cycles_min", "-"), r.get("cycles_max", "-")))
    else:
        lines.append("tmmtop  snapshot  read_span=%ss" % snap["read_span_s"])
        for s in sorted(snap["slots"], key=lambda x: int(x)):
            d = snap["slots"][s]
            lab = labels.get(s, s)
            if "error" in d:
                lines.append("  %-14s %s" % (lab, d["error"]))
            else:
                lines.append("  %-14s " % lab + "  ".join(
                    "%s=%s" % (k, d[k]) for k in FIELDS if k in d))
    return "\n".join(lines)


# The probe tmmtop arms for itself. device_poll because the poll loop runs whether
# or not anything is being served, so "is the scheduler alive" needs no traffic --- the
# lesson that cost an hour on 2026-09-05, when an HTTP hook armed cleanly and reported
# fired=0 through requests that were returning 200 because the virtual server was fastL4.
SETUP_PROBE = "poll_probe"
SETUP_HOOK = "device_poll"


def setup(loader, slot, progdir):
    """Load and arm tmmtop's own probe. Returns (ok, message).

    WHY THIS EXISTS. Without it the tool is only usable by someone who already knows
    which slots hold what, has loaded a program into one, and has armed it --- which is
    everyone who built it and nobody else. `--setup` is the difference between a tool
    and a thing you have to be told how to hold.

    IT REFUSES RATHER THAN GUESSES in two places. It will not arm over a slot that is
    already armed, because that slot belongs to whoever armed it and a monitoring tool
    stealing it is worse than a monitoring tool that will not start. And it will not
    invent a program path: if the signed object is not where it was told to look, it
    says where it looked."""
    prog = os.path.join(progdir, SETUP_PROBE + ".bpf.o")
    if not os.path.exists(prog):
        # THE IMAGE BAKES NO BYTECODE, ON PURPOSE, so this directory is normally
        # absent and that is not a packaging bug. Compiling, verifying and signing
        # programs is a separate stage from imaging (docs/BYTECODE-BUILD.md), which
        # is what keeps a program's provenance independent of the image it runs on.
        # So --setup works when a signed probe has been PUT here, and says so rather
        # than reading as a missing file.
        return False, (
            "no %s in %s.\n"
            "        The image bakes no bytecode by design, so this is expected on a\n"
            "        stock pod rather than a fault. Either point --progdir at a signed\n"
            "        probe, or arm one from the host and drop --setup:\n"
            "          bnk-deliver-program.py <dir>/%s.bpf.o <slot> 1\n"
            "          ls-load.py arm <slot> %s\n"
            "          tmmtop --slots <slot> --label <slot>=%s"
            % (os.path.basename(prog), progdir, SETUP_PROBE, SETUP_HOOK, SETUP_HOOK))
    cur = read_slot(loader, slot)
    if "error" not in cur and cur.get("armed") == 1:
        return False, ("slot %d is ALREADY ARMED (mode=%s, gen=%s). Refusing to take it: "
                       "it belongs to whoever armed it. Pick another --setup-slot."
                       % (slot, cur.get("mode"), cur.get("gen")))
    try:
        r = subprocess.run([loader, "load", str(slot), prog, "1"],
                           capture_output=True, text=True, timeout=30)
        out = (r.stdout + r.stderr).strip()
    except Exception as e:
        return False, "load failed: %s: %s" % (type(e).__name__, e)
    if "signature=verified" not in out:
        return False, "load did not report a verified signature: " + out[-160:]
    try:
        r = subprocess.run([loader, "arm", str(slot), SETUP_HOOK],
                           capture_output=True, text=True, timeout=30)
        out2 = (r.stdout + r.stderr).strip()
    except Exception as e:
        return False, "arm failed: %s: %s" % (type(e).__name__, e)
    if "ARMED" not in out2:
        return False, "arm did not report ARMED: " + out2[-160:]
    return True, "armed %s at %s in slot %d" % (SETUP_PROBE, SETUP_HOOK, slot)



def human(n):
    """Bytes as a short string. Binary units, labelled as such --- KiB not KB, because
    a memory figure off by 2.4% is the kind of thing that gets argued about."""
    if not isinstance(n, int):
        return str(n)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if abs(n) < 1024 or unit == "GiB":
            return "%d %s" % (n, unit) if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024.0
    return str(n)


# ---- tmstat, via tmctl -------------------------------------------------------
#
# THE SOURCE THE MEMORY AND NETWORK PANES NEEDED, and it was in the pod all along.
# Shield slot counters can only report what a loaded program measures, so allocator
# and drop state are invisible that way --- which is why these panes did not exist.
# TMM publishes its own stat tables into shared memory under /var/tmstat/blade, and
# `tmctl` reads them. 856 tables.
#
# THE INVOCATION IS `tmctl -d blade`, and finding that cost a detour worth recording:
# bare `tmctl` fails with "tmstat_subscribe cluster: No such file or directory",
# which reads like a broken install. It is not --- it defaults to a `cluster` segment
# this deployment does not have. `-d blade` selects the one it does.
TMCTL = "/usr/bin/tmctl"
TMSTAT_DIR = "blade"

# Gauges describe a level right now; differencing them is meaningless, exactly like
# cycles_min/max in the slot table. Kept apart for the same reason.
MEM_GAUGES = ("used", "avail", "allocated", "max_allocated")
MEM_COUNTERS = ("fail_allocs",)
NET_COUNTERS = ("dropped_packets", "incoming_packet_errors", "outgoing_packet_errors",
                "connection_memory_errors")


def read_tmctl(table, tmctl=TMCTL):
    """[{column: value}] for one tmstat table, or [] on any failure.

    Parses tmctl's aligned column output: a header line, a rule line of dashes, then
    rows. Values that look like integers are converted; everything else stays a
    string, because a name column silently becoming 0 is worse than a name column."""
    try:
        r = subprocess.run([tmctl, "-d", TMSTAT_DIR, table],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return []
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    if len(lines) < 2 or not set(lines[1].strip()) <= set("- "):
        return []                      # no header/rule pair: not a table we can read
    cols = lines[0].split()
    out = []
    for line in lines[2:]:
        vals = line.split()
        if len(vals) != len(cols):
            continue                   # ragged row: skip it rather than mis-align
        row = {}
        for c, v in zip(cols, vals):
            try:
                row[c] = int(v)
            except ValueError:
                row[c] = v
        out.append(row)
    return out


def mem_snapshot(tmctl=TMCTL):
    """Physical memory, plus any umem cache that has FAILED an allocation.

    Only failing caches are listed, not the top consumers. A cache being large is
    normal; a cache that could not satisfy a request is the thing worth a line on a
    one-screen tool, and 200 rows of normal hides it."""
    phys = read_tmctl("tmm/physmem", tmctl)
    caches = read_tmctl("tmm/umem_usage_stat", tmctl)
    failing = [c for c in caches if isinstance(c.get("fail_allocs"), int)
               and c["fail_allocs"] > 0]
    return {"physmem": phys[0] if phys else {"error": "unreadable"},
            "caches_total": len(caches),
            "caches_failing": sorted(failing, key=lambda c: -c["fail_allocs"])[:8]}


def read_tmctl_pivot(table, tmctl=TMCTL):
    """{field: value} from `tmctl -P`, which prints one field per line.

    WHY PIVOTED. tmm_stat is ONE ROW with 158 columns, so the drop counters are
    columns rather than rows --- and reading `tmctl -C` (describe columns) as if it
    were data is exactly the mistake that made the first version of the network pane
    report "no drop counters found" against a table that has four of them. `-P`
    turns the row on its side and gives name/value pairs."""
    try:
        r = subprocess.run([tmctl, "-d", TMSTAT_DIR, "-P", table],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return {}
    out = {}
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2:
            try:
                out[parts[0]] = int(parts[1])
            except ValueError:
                out[parts[0]] = parts[1]
    return out


def net_snapshot(tmctl=TMCTL):
    """The drop and error counters from tmm_stat."""
    d = read_tmctl_pivot("tmm_stat", tmctl)
    if not d:
        return {"error": "tmm_stat unreadable (is tmctl present?)"}
    wanted = {k: d[k] for k in NET_COUNTERS if isinstance(d.get(k), int)}
    return wanted or {"error": "tmm_stat read, but none of %s present" % (NET_COUNTERS,)}


def sched_snapshot(tmctl=TMCTL):
    """The poll loop, straight from TMM rather than from an armed shield.

    A BETTER SOURCE THAN THE ONE THIS TOOL STARTED WITH. tmm_stat carries `polls` and
    `idle_polls`, so "is the scheduler busy" is answerable with NO shield armed at all
    --- where the slot table needs a probe loaded, armed, and signed for this build.
    The slot view is still worth having: it measures what a shield costs, which this
    cannot see. They answer different questions."""
    d = read_tmctl_pivot("tmm_stat", tmctl)
    if not isinstance(d.get("polls"), int):
        return {"error": "tmm_stat has no `polls` column"}
    polls, idle = d["polls"], d.get("idle_polls", 0)
    out = {"polls": polls, "idle_polls": idle}
    if polls:
        # A GAUGE COMPUTED FROM TWO ACCUMULATORS is a lifetime average, not a rate.
        # Labelled that way: it is the fraction of all polls since boot that found
        # nothing to do, which is not the same as "idle now".
        out["idle_fraction_since_boot"] = round(idle / float(polls), 4)
    return out


def main(argv):
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--slots", default="0-7", help="slot list/range, e.g. 4,5 or 0-7")
    ap.add_argument("--label", action="append", default=[], metavar="N=NAME",
                    help="name a slot; unlabelled slots report as their number")
    ap.add_argument("--once", action="store_true", help="one snapshot, no rates")
    ap.add_argument("--interval", type=float, default=None,
                    help="seconds between the two samples used for rates")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-d", "--delay", type=float, default=2.0,
                    help="seconds between refreshes in continuous mode (default 2)")
    ap.add_argument("-n", "--count", type=int, default=0,
                    help="stop after N refreshes (0 = until interrupted)")
    ap.add_argument("--setup", action="store_true",
                    help="load and arm tmmtop's own probe (%s at %s) before watching"
                         % (SETUP_PROBE, SETUP_HOOK))
    ap.add_argument("--setup-slot", type=int, default=6,
                    help="which slot --setup uses (default 6); refuses if already armed")
    ap.add_argument("--progdir", default="/usr/share/ls/shields",
                    help="where --setup looks for the signed probe")
    ap.add_argument("--mem", action="store_true",
                    help="memory pane: physmem, and any umem cache that FAILED an alloc")
    ap.add_argument("--net", action="store_true",
                    help="network pane: drop and packet-error counters from tmm_stat")
    ap.add_argument("--sched", action="store_true",
                    help="scheduler pane: polls / idle_polls from tmm_stat, no shield needed")
    ap.add_argument("--tmctl", default=TMCTL, help="path to tmctl (reads /var/tmstat/blade)")
    a = ap.parse_args(argv[1:])

    slots = []
    for part in a.slots.split(","):
        if "-" in part:
            lo, hi = part.split("-", 1)
            slots += list(range(int(lo), int(hi) + 1))
        else:
            slots.append(int(part))
    labels = {}
    for kv in a.label:
        k, _, v = kv.partition("=")
        labels[k.strip()] = v.strip()

    loader = find_loader()

    if a.setup:
        # Before anything is watched, and it FAILS THE RUN rather than warning. A
        # monitoring tool that could not arm what it came to watch, then draws an
        # empty table, is indistinguishable from one watching an idle system --- and
        # "the counters are all zero" is the single most misleading thing this tool
        # can display.
        good, msg = setup(loader, a.setup_slot, a.progdir)
        print("tmmtop --setup: %s" % msg)
        if not good:
            return 2
        if a.setup_slot not in slots:
            slots.append(a.setup_slot)
        labels.setdefault(str(a.setup_slot), SETUP_HOOK)

    def panes():
        """The memory and network panes, as text. Empty when neither was asked for."""
        out = []
        if a.mem:
            m = mem_snapshot(a.tmctl)
            ph = m["physmem"]
            if "error" in ph:
                out.append("memory   %s (is tmctl present and /var/tmstat/blade readable?)" % ph["error"])
            else:
                used, avail = ph.get("used", 0), ph.get("avail", 0)
                tot = used + avail
                out.append("memory   physmem used %s of %s (%.1f%%)   umem caches %d"
                           % (human(used), human(tot),
                              (100.0 * used / tot) if tot else 0.0, m["caches_total"]))
            for c in m["caches_failing"]:
                out.append("  ALLOC FAILURES  %-30s fail_allocs=%d used=%s"
                           % (c.get("name"), c["fail_allocs"], human(c.get("used", 0))))
            if not m["caches_failing"] and "error" not in ph:
                out.append("  no umem cache has failed an allocation")
        if a.sched:
            sc = sched_snapshot(a.tmctl)
            if "error" in sc:
                out.append("sched    %s" % sc["error"])
            else:
                out.append("sched    polls %d   idle %d   idle fraction since boot %.1f%%"
                           % (sc["polls"], sc["idle_polls"],
                              100.0 * sc.get("idle_fraction_since_boot", 0.0)))
                out.append("         (a lifetime average, not \"idle now\" --- both are"
                           " counters since boot)")
        if a.net:
            n = net_snapshot(a.tmctl)
            if "error" in n:
                out.append("network  %s" % n["error"])
            else:
                out.append("network  " + "  ".join("%s=%d" % (k, n[k]) for k in sorted(n)))
        return out

    if a.once:
        snap = sample(loader, slots)
        if a.json:
            if a.mem:
                snap["memory"] = mem_snapshot(a.tmctl)
            if a.net:
                snap["network"] = net_snapshot(a.tmctl)
            if a.sched:
                snap["scheduler"] = sched_snapshot(a.tmctl)
            print(json.dumps(snap, indent=2))
        else:
            print(render(snap, labels, False))
            for line in panes():
                print(line)
        return 0

    if a.interval is not None:            # explicit two-sample mode, kept for scripts
        first = sample(loader, slots)
        time.sleep(a.interval)
        second = sample(loader, slots)
        r = rates(first, second, labels)
        print(json.dumps(r, indent=2) if a.json else render(r, labels, True))
        return 0

    # --- continuous, the default. Each tick diffs against the previous tick. ---
    # Redraw in place only on a TTY; when piped, append so the output stays greppable and a
    # consumer gets one record per line instead of a screenful of escape codes.
    tty = sys.stdout.isatty() and not a.json
    prev = sample(loader, slots)
    ticks = 0
    try:
        while True:
            time.sleep(a.delay)
            cur = sample(loader, slots)
            r = rates(prev, cur, labels)
            if a.json:
                print(json.dumps(r), flush=True)      # JSON Lines: one object per tick
            else:
                if tty:
                    sys.stdout.write("\033[H\033[2J")   # home + clear, like top
                print(render(r, labels, True), flush=True)
            prev = cur
            ticks += 1
            if a.count and ticks >= a.count:
                return 0
    except KeyboardInterrupt:
        if tty:
            sys.stdout.write("\n")
        return 0                          # interrupting a monitor is not a failure


if __name__ == "__main__":
    sys.exit(main(sys.argv))
