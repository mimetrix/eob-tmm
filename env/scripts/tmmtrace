#!/bin/sh
# tmmtrace --- the trace DSL from your Mac, end to end. You type the DSL here; the
# build box compiles+verifies+signs (toolchain + key stay there), the deploy box
# arms and observes. This box only orchestrates over SSH --- no toolchain, no key.
#
#   tmmtrace run    '<expr>' [nreq]
#   tmmtrace verify '<expr>' | gen '<expr>' | list '<glob>'
#
# Requires SSH to both boxes (you already have it):
BUILD="${BUILD:-starin@10.145.37.36}"     # eob-bnk-build-01  (toolchain + key)
DEPLOY="${DEPLOY:-starin@10.145.40.193}"  # eob-bnk-datkube-01 (kubectl + pod)

cmd="$1"; expr="$2"; nreq="${3:-40}"
case "$cmd" in
  verify|gen|list)
    exec ssh "$BUILD" "~/tmmtrace $cmd '$expr'" ;;
  run) : ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac

echo "probe : $expr"
# 1. build + verify + sign on the builder; it ships the signed probe to the target
info=$(ssh "$BUILD" "~/tmmtrace build-ship '$expr'") || { echo "*** build/sign failed"; exit 1; }
set -- $info; fn="$1"; hook="$2"; kind="$3"
[ -n "$fn" ] || { echo "*** builder returned no artifact"; exit 1; }
echo "built+verified+signed on $BUILD, shipped to target: $fn ($kind)"
# 2. arm + observe on the target
exec ssh "$DEPLOY" "~/tmmtrace-arm '$fn' '$hook' '$kind' '$nreq'"
