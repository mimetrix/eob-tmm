#!/bin/sh
# tmmtrace --- in the TMM toolbox pod. A utility for INSTRUMENTING a running TMM:
# author a probe (gen -> clang -> PREVAIL -> F5-sign), arm it over the socket, read
# TMM's own counters and evidence ring, disarm. This is what an engineer runs after
# `kubectl exec -it <toolbox>`.
#
# It does NOT generate traffic. Load comes from real traffic or from the operator,
# visibly --- never from a hidden script inside this tool.
#
#   tmmtrace arm    '<expr>'      author + verify + sign + arm (monitor), then HOLD
#   tmmtrace status [slot]        read TMM's counters: fired / matched since arm
#   tmmtrace reset  [slot]        zero the 'since arm' counter, no re-arm (per-batch counts)
#   tmmtrace disarm '<hook>'      remove the probe (a NAME, e.g. http_parse_client_headers)
#   tmmtrace cost   '<expr>'      poll-loop cost: budget-pass ceiling + measured floor
#   tmmtrace verify '<expr>' | gen '<expr>' | list '<glob>' [--no-noise ...]
#
# A shield expr ---  fentry/<hook> /pred/ { shield(<safe value>) }  --- run through `arm`
# is authored + PREVAIL-verified + signed at mode-ceiling=enforce, then STOPS. Arming
# enforce on live traffic is a separate, gated step (the tool prints the exact commands).
#
# NOTE the signing key is mounted from a Secret here for the demo; in production it
# lives in a sign service and the toolbox calls out to it --- the pod never holds it.
set -e
export CLANG="${CLANG:-clang}"
export PREVAIL="${PREVAIL:-/opt/tmmtrace/prevail}"
export LS_SIGS="${LS_SIGS:-/opt/tmmtrace/signatures.tsv}"
export LS_TYPES="${LS_TYPES:-/opt/tmmtrace/types.json}"
export LS_HOOKMAP="${LS_HOOKMAP:-/opt/tmmtrace/hook-map.json}"
TT=/opt/tmmtrace/tmmtrace.py
SIGN=/opt/tmmtrace/sign_shield.py
SK="${SK:-/etc/tmmtrace-key/shield_sk.pem}"
VS="${VS:-http://11.11.11.99/}"
SLOT="${SLOT:-2}"

f5pod() { kubectl get pods -l app=f5-tmm --no-headers | grep Running | head -1 | awk '{print $1}'; }

cmd="$1"
case "$cmd" in
  verify|gen|list) shift; exec python3 "$TT" "$cmd" "$@" ;;   # pass ALL args (list takes --flags)
  arm|cost) expr="$2" ;;

  status)                                                      # read TMM's counters; no probe change
    s="${2:-$SLOT}"; POD=$(f5pod)
    [ -n "$POD" ] || { echo "*** no Running f5-tmm pod"; exit 1; }
    cur=$(kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py status "$s")
    cf=$(echo "$cur" | grep -o 'fired=[0-9]*'        | cut -d= -f2)
    cm=$(echo "$cur" | grep -o 'safe_returns=[0-9]*' | cut -d= -f2)
    base=$(kubectl exec "$POD" -c f5-tmm -- cat /tmp/tt-slot$s.base 2>/dev/null || echo "0 0")
    bf=$(echo "$base" | awk '{print $1}'); bm=$(echo "$base" | awk '{print $2}')
    F=$((cf-bf)); M=$((cm-bm))
    echo "slot $s  since arm:   fired (hook hits) = $F    matched (count) = $M"
    [ "$F" -gt 0 ] 2>/dev/null && echo "                    match rate = $(awk "BEGIN{printf \"%.1f%%\",100*$M/$F}")"
    echo "  (TMM's own tally --- drive more traffic and run status again to watch it move)"
    exit 0 ;;

  disarm)                                                      # remove a probe by hook NAME
    h="$2"; [ -n "$h" ] || { echo "usage: tmmtrace disarm '<hook>'"; exit 1; }
    POD=$(f5pod); [ -n "$POD" ] || { echo "*** no Running f5-tmm pod"; exit 1; }
    kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py disarm "$h" >/dev/null 2>&1 \
      && echo "disarmed $h" || echo "disarm $h: nothing armed there"
    exit 0 ;;

  reset)                                                       # zero the "since arm" delta WITHOUT re-arming
    s="${2:-$SLOT}"; POD=$(f5pod); [ -n "$POD" ] || { echo "*** no Running f5-tmm pod"; exit 1; }
    cur=$(kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py status "$s")
    cf=$(echo "$cur"|grep -o 'fired=[0-9]*'|cut -d= -f2); cm=$(echo "$cur"|grep -o 'safe_returns=[0-9]*'|cut -d= -f2)
    kubectl exec "$POD" -c f5-tmm -- sh -c "echo '$cf $cm' > /tmp/tt-slot$s.base"
    echo "slot $s counter zeroed --- drive traffic to watch it climb from 0 again"
    exit 0 ;;

  *) sed -n '2,20p' "$0"; exit 1 ;;
esac

echo "probe : $expr"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
python3 "$TT" build "$expr" "$tmp" | sed 's/^/  /'            # gen -> clang -> PREVAIL
o=$(ls "$tmp"/*.bpf.o); fn=$(basename "$o" .bpf.o)
hook=$(python3 -c "import json;print(json.load(open('$tmp/$fn.meta.json'))['hook'])")
kind=$(python3 -c "import json;print(json.load(open('$tmp/$fn.meta.json'))['kind'])")
sec=$(python3 -c "import json;print(json.load(open('$tmp/$fn.meta.json'))['section'])")

if [ "$cmd" = cost ]; then
  echo "-- what it costs the poll loop --"
  echo "  PROVEN CEILING --- per program, computed live from THIS verified bytecode:"
  echo "  (budget pass walks the control-flow graph for its longest path -> a worst-case cycle count)"
  python3 /opt/tmmtrace/budget_pass.py --section "$sec" "$o" | sed 's/^/    /'
  echo "  MEASURED FLOOR --- the mechanism, from the recorded microbenchmark (GROUND_TRUTH.md):"
  echo "    trampoline       ~8.76 ns/call   (22.8 cyc @ 2.60 GHz --- the register save + dispatch)"
  echo "    + a small program ~13.8 ns total (35.8 cyc); the program's own cycles stay under the"
  echo "                                       ceiling above. Hot-cache floor; real traffic runs colder."
  echo "  PREVAIL proves the program HALTS; the budget bounds HOW LONG. It cannot hang or"
  echo "  monopolize the poll loop --- that pair is what earns it a place there."
  echo "  (Note: bench measures relocation-free objects; a CO-RE probe is bounded by the ceiling, not bench.)"
  exit 0
fi

if [ "$kind" = shield ]; then
  # ENFORCE authoring: verify + sign at mode-ceiling=enforce, then STOP. Arming enforce on
  # live traffic is a deliberate, gated step --- the tool authors it; a human vets + arms it.
  sv=$(python3 -c "import json;print(json.load(open('$tmp/$fn.meta.json')).get('safe_value',''))")
  echo "hook  : $hook   mode: ENFORCE   safe_value: $sv"
  python3 "$SIGN" --key "$SK" --prog "$o" --hook "$hook" --mode-ceiling enforce \
      -o "$tmp/$fn.bpf.sig" | grep -i 'prog sha256' | sed 's/^/  signed /'
  # Stage the artifacts into the TMM pod so the printed arm commands actually work.
  # (Signing + staging is safe; ARMING is the gated step and still requires a human.)
  POD=$(f5pod); [ -n "$POD" ] || { echo "*** no Running f5-tmm pod"; exit 1; }
  kubectl cp "$o" "$POD":/tmp/$fn.bpf.o -c f5-tmm
  kubectl cp "$tmp/$fn.bpf.sig" "$POD":/tmp/$fn.bpf.sig -c f5-tmm
  echo "  staged into $POD:/tmp/$fn.bpf.{o,sig}"
  echo "  VERIFIED + SIGNED at mode-ceiling=enforce.  NOT armed --- enforce is gated."
  echo "  Before arming on live traffic, vet the three properties (enforce caveats):"
  echo "    1. the safe value ($sv) is a return the caller already handles;"
  echo "    2. skipping the body is a clean early-return (no half-updated state);"
  echo "    3. the predicate reads a field available AT ENTRY (fentry runs before the body)."
  echo "  To arm (deliberate), inside the f5-tmm pod --- load AT enforce (mode 2), then arm:"
  echo "    ls-load.py load <slot> /tmp/$fn.bpf.o 2      # mode 2 = enforce"
  echo "    ls-load.py arm  <slot> $hook"
  echo "  The safe value ($sv) reaches the slot via LS_SHIELD_SAFE_VALUE in TMM's environment"
  echo "  at arm time (read by ls_vm_arm, per-slot); confirm it is set before arming."
  exit 0
fi

# OBSERVE: sign (monitor), load, arm, record a baseline, then HOLD. No traffic is driven ---
# tmmtrace instruments; load comes from real traffic or the operator, read via `status`.
python3 "$SIGN" --key "$SK" --prog "$o" --hook "$hook" --mode-ceiling monitor \
    -o "$tmp/$fn.bpf.sig" | grep -i 'prog sha256' | sed 's/^/  signed /'
POD=$(f5pod); [ -n "$POD" ] || { echo "*** no Running f5-tmm pod"; exit 1; }
kubectl cp "$o"  "$POD":/tmp/$fn.bpf.o  -c f5-tmm
kubectl cp "$tmp/$fn.bpf.sig" "$POD":/tmp/$fn.bpf.sig -c f5-tmm   # load verifies the sig beside the .o
L=$(kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py load $SLOT /tmp/$fn.bpf.o 1 2>&1)
echo "$L" | grep -q 'OK loaded' || { echo "*** load failed: $L"; exit 1; }
kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py disarm "$hook" >/dev/null 2>&1 || true
A=$(kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py arm $SLOT "$hook" 2>&1)
pad=$(echo "$A" | grep -oE '0x[0-9a-f]+' | head -1)
b=$(kubectl exec "$POD" -c f5-tmm -- /usr/bin/ls-load.py status $SLOT)
bf=$(echo "$b"|grep -o 'fired=[0-9]*'|cut -d= -f2); bm=$(echo "$b"|grep -o 'safe_returns=[0-9]*'|cut -d= -f2)
kubectl exec "$POD" -c f5-tmm -- sh -c "echo '$bf $bm' > /tmp/tt-slot$SLOT.base"
echo
echo "  ---- what tmmtrace just did:  author -> armed, over a socket, no restart ----"
echo "    VERIFIED   PREVAIL proved it memory-safe + bounded --- it cannot crash or hang TMM"
echo "    SIGNED     with the F5 key --- the loader refuses anything unsigned"
echo "    ARMED      rewrote the 5-byte entry pad${pad:+ at $pad} to call the probe"
echo "    HOLDING    live on slot $SLOT in MONITOR --- records the verdict, never blocks traffic"
echo
echo "  armed : $hook   slot $SLOT (monitor)   pod $POD"
echo "  tmmtrace reads TMM's OWN counters --- it does NOT generate traffic."
echo "  drive load, then:   tmmtrace status $SLOT     # fired/matched SINCE ARM (cumulative)"
echo "                      tmmtrace reset  $SLOT     # zero it between batches, no re-arm"
echo "  remove it:          tmmtrace disarm '$hook'"
