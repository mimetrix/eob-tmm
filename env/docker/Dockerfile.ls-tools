# Catalog-free deployment layer. Discovery/type catalogs are generated from the
# packaged runtime/debug pair on the build box and stay there. Programs carry a
# signed .ls.target record and already-relocated field accesses.
#
# Earlier layers installed hook-index.tsv and signatures.tsv even without BTF.
# That was not catalog-free (GROUND_TRUTH, 2026-09-24). No COPY-and-delete here:
# the bake audits every distributable layer, including BASE, before delivery.
ARG BASE=tmm:local
FROM ${BASE}

COPY --chmod=0644 runtime-identity.json /usr/share/ls/runtime-identity.json
COPY --chmod=0755 ls-load.py /usr/bin/ls-load.py
COPY --chmod=0755 ls_drain /usr/bin/ls_drain
# tmmtop measures inside the container to avoid kubectl latency per sample.
COPY --chmod=0755 tmmtop /usr/bin/tmmtop

# The packaged padded executable, with no embedded BTF. No bytecode programs or
# debug/type catalogs are baked. The identity receipt checks full build ID + SHA.
COPY --chmod=0755 tmm64.no_pgo /usr/bin/tmm64.no_pgo
# Dockerfile.runtime may select the unpadded debug configuration. Always select
# the packaged default; the build gate checks the resolved path and its bytes.
RUN ln -sf /usr/bin/tmm.default /usr/bin/tmm

COPY --chmod=0644 ls_buildid.py /usr/share/ls/ls_buildid.py
COPY --chmod=0755 ls-verify-layer.sh /usr/share/ls/ls-verify-layer.sh
RUN /usr/share/ls/ls-verify-layer.sh
