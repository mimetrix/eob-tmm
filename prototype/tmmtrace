#!/usr/bin/env python3
"""
tmmtrace — a bpftrace-style front-end to TMM's embedded eBPF VM (prototype).

This is the *user-facing face* of the embedded-eBPF substrate: you write a
one-liner, tmmtrace compiles it to an eBPF shield, (optionally) runs it through
the PREVAIL verify gate, and loads it into minimm's embedded uBPF VM — the same
"mini-TMM" backend the other demos drive.

The point of THIS tool: one language spans BOTH halves of the substrate, chosen
by the action verb —

    OBSERVE (tracepoint / diagnostics)   count()  hist(args.f)  snapshot()
    FILTER  (the CVE shield / enforce)   drop()

    tmm:l7:frame /args.opcode >= 4/ { count(); }     # watch the precondition
    tmm:l7:frame /args.opcode >= 4/ { drop();  }     # ship the mitigation
    tmm:l7:frame /args.opcode >= 4/ { drop(); snapshot(); }   # combined play

Same compile -> verify -> load pipeline; the only differences are which minimm
build runs it (minimm-trace vs minimm-ubpf) and — in production — the
authorization tier (enforce is gated harder than observe). "Explore -> shield"
in one grammar.

Subcommands:
    tmmtrace list  [pattern]        list probes from the build's hook-point map
    tmmtrace compile 'ONELINER'     parse -> codegen -> clang -> (verify); show the plan
    tmmtrace run     'ONELINER'     compile, then drive minimm end-to-end and report

This is a prototype front-end: the grammar is a deliberately small, real subset
(enough for the synthetic-CVE story), and it drives the existing minimm host —
it does not reimplement it.
"""
import argparse
import json
import os
import re
import shutil
import socket
import struct
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
MAP = os.path.join(HERE, "hook-point-map.json")
SHIELDS = os.path.join(HERE, "shields")
GEN = os.path.join(HERE, ".tmmtrace")            # generated .bpf.c/.o (gitignored)
MM_UBPF = os.path.join(HERE, "minimm", "minimm-ubpf")
MM_TRACE = os.path.join(HERE, "minimm", "minimm-trace")

# ls_ctx scalar fields a predicate may test (must match ls_shield.h / the map).
FIELDS = {"opcode": "u16", "payload_len": "u16", "avail_len": "u32"}
OPS = {">=", "<=", "==", "!=", ">", "<"}
OBSERVE_VERBS = {"count", "hist", "snapshot"}
FILTER_VERBS = {"drop"}

C_HEADER = """\
/* GENERATED by tmmtrace from: %s
 * Do not edit by hand. This is the eBPF shield the one-liner compiles to;
 * it is exactly the kind of program the substrate loads into TMM's VM. */
#include <stdint.h>

struct ls_ctx {
	uint16_t opcode;
	uint16_t payload_len;
	uint32_t avail_len;
	uint32_t mode;        /* host fills in: 1=monitor 2=enforce */
	uint8_t  head[16];
};
#define LS_ENFORCE   2
#define LS_FR_TRIGGER 0x100u

uint64_t ls_decision(void *data)
{
	struct ls_ctx *ctx = data;
"""


class ParseError(Exception):
    pass


# --------------------------------------------------------------------------- #
# parse                                                                        #
# --------------------------------------------------------------------------- #

def parse(oneliner):
    """Return dict: probe, pred (or None), actions[list], fields-used."""
    m = re.match(r"\s*([\w:*-]+)\s*(?:/(.*?)/)?\s*\{(.*)\}\s*$", oneliner, re.S)
    if not m:
        raise ParseError("expected:  PROBE [/PREDICATE/] { ACTION; ... }")
    probe, pred_s, body = m.group(1), m.group(2), m.group(3)

    pred = None
    if pred_s and pred_s.strip():
        pm = re.match(r"\s*args\.(\w+)\s*(>=|<=|==|!=|>|<)\s*(0x[0-9a-fA-F]+|\d+)\s*$",
                      pred_s.strip())
        if not pm:
            raise ParseError("predicate must be  args.FIELD OP CONST  "
                             "(FIELD in %s; OP in %s)" % (",".join(FIELDS), " ".join(sorted(OPS))))
        f, op, const = pm.group(1), pm.group(2), int(pm.group(3), 0)
        if f not in FIELDS:
            raise ParseError("unknown field 'args.%s' — this hook exposes: %s"
                             % (f, ", ".join(FIELDS)))
        pred = {"field": f, "op": op, "const": const}

    actions = []
    for raw in body.split(";"):
        raw = raw.strip()
        if not raw:
            continue
        am = re.match(r"(\w+)\s*\(\s*(.*?)\s*\)\s*$", raw)
        if not am:
            raise ParseError("action must be a call like drop() / count() / hist(args.opcode): %r" % raw)
        verb, arg = am.group(1), am.group(2)
        if verb not in OBSERVE_VERBS | FILTER_VERBS:
            raise ParseError("unknown action %r — known: %s"
                             % (verb, ", ".join(sorted(OBSERVE_VERBS | FILTER_VERBS))))
        actions.append({"verb": verb, "arg": arg})
    if not actions:
        raise ParseError("no actions — put at least one verb in { }")
    return {"probe": probe, "pred": pred, "actions": actions}


def classify(ast):
    """Decide OBSERVE vs FILTER from the action verbs; validate the mix."""
    verbs = {a["verb"] for a in ast["actions"]}
    is_filter = bool(verbs & FILTER_VERBS)
    if is_filter and (verbs & OBSERVE_VERBS - {"snapshot"}):
        raise ParseError("can't mix an enforcement verb (drop) with telemetry "
                         "aggregation (count/hist) in one program; snapshot() is OK "
                         "(that's the combined play)")
    mode = "filter" if is_filter else "observe"
    snapshot = "snapshot" in verbs
    return mode, snapshot


def pred_c(pred):
    return "ctx->%s %s %u" % (pred["field"], pred["op"], pred["const"])


# --------------------------------------------------------------------------- #
# codegen + compile + verify                                                   #
# --------------------------------------------------------------------------- #

def codegen(ast, mode, snapshot, source):
    body = C_HEADER % source
    if mode == "filter":
        cond = pred_c(ast["pred"]) if ast["pred"] else "1"
        body += "\t/* FILTER: the return picks a host-owned outcome (0 pass / 2 drop) */\n"
        body += "\tif (%s) {\n" % cond
        body += "\t\tif (ctx->mode == LS_ENFORCE) return 2;   /* matched -> host DROPs */\n"
        body += "\t\treturn 1;                                /* matched, monitor -> pass */\n"
        body += "\t}\n\treturn 0;\n}\n"
    else:
        body += "\t/* OBSERVE: return telemetry only; host never changes flow. */\n"
        body += "\tuint64_t r = ctx->opcode & 0xff;   /* histogram sample */\n"
        if snapshot:
            cond = pred_c(ast["pred"]) if ast["pred"] else "1"
            body += "\tif (%s) r |= LS_FR_TRIGGER;   /* snapshot(): arm the flight recorder */\n" % cond
        body += "\treturn r;\n}\n"
    return body


def compile_shield(ast, source):
    mode, snapshot = classify(ast)
    os.makedirs(GEN, exist_ok=True)
    stem = os.path.join(GEN, "gen_%s" % mode)
    csrc, obj = stem + ".bpf.c", stem + ".bpf.o"
    with open(csrc, "w") as fh:
        fh.write(codegen(ast, mode, snapshot, source))
    arch = os.uname().machine
    cmd = ["clang", "-O2", "-target", "bpf",
           "-idirafter", "/usr/include/%s-linux-gnu" % arch,
           "-idirafter", "/usr/include", "-c", csrc, "-o", obj]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise ParseError("clang failed:\n" + r.stderr)
    return mode, snapshot, csrc, obj


def find_verifier():
    v = os.environ.get("LS_VERIFIER")
    if v and shutil.which(v):
        return v
    cand = os.path.join(HERE, "..", "ebpf-verifier", "bin", "prevail")
    return cand if os.access(cand, os.X_OK) else None


def verify(obj):
    """Run the PREVAIL gate like minimm's ls_verify(); return (ran, ok)."""
    v = find_verifier()
    if not v:
        return False, None
    r = subprocess.run([v, "-q", "--section", ".text", obj], capture_output=True, text=True)
    return True, (r.returncode == 0)


# --------------------------------------------------------------------------- #
# list                                                                         #
# --------------------------------------------------------------------------- #

def cmd_list(pattern):
    with open(MAP) as fh:
        m = json.load(fh)
    print("hook-point map: %s  (build %s)" % (m["tmos_version"], m["build_id"]))
    pat = pattern.replace("tmm:", "").replace("*", "")
    for hp in m["hook_points"]:
        name = hp["name"]
        if pat and pat not in name:
            continue
        print("\n  tmm hook: \033[1m%s\033[0m" % name)
        print("    attach_mode : %s   (observe %s, filter %s)"
              % (hp["attach_mode"],
                 "yes", "yes" if hp["attach_mode"] == "filter" else "NO"))
        print("    path_class  : %s" % hp["path_class"])
        fields = hp.get("arg_btf", {}).get("arg0", {}).get("fields", {})
        print("    args        : " + ", ".join("args.%s (%s)" % (k, v) for k, v in fields.items()))
    print("\n(one hook in this prototype build; a production map spans the L3/L4, "
          "TLS, L7, plugin and runtime stages.)")


def check_probe_allows(mode):
    """The prototype has one filter-capable hook that also serves observe."""
    with open(MAP) as fh:
        m = json.load(fh)
    hp = m["hook_points"][0]
    if mode == "filter" and hp["attach_mode"] != "filter":
        raise ParseError("drop() needs a FILTER hook; '%s' is attach_mode=%s"
                         % (hp["name"], hp["attach_mode"]))
    return hp["name"]


# --------------------------------------------------------------------------- #
# compile (report only)                                                        #
# --------------------------------------------------------------------------- #

def cmd_compile(oneliner, show_c=True):
    ast = parse(oneliner)
    mode, snapshot = classify(ast)
    hook = check_probe_allows(mode)
    mode2, snapshot2, csrc, obj = compile_shield(ast, oneliner)
    ran, ok = verify(obj)

    tier = "observe (read-only; lowest authz tier)" if mode == "observe" \
        else "FILTER/enforce (higher authz tier — SIRT-signed in production)"
    print("── tmmtrace compile ──────────────────────────────────────────")
    print("  one-liner : %s" % oneliner.strip())
    print("  probe     : %s  →  hook '%s'" % (ast["probe"], hook))
    if ast["pred"]:
        print("  predicate : %s" % pred_c(ast["pred"]))
    print("  actions   : %s" % ", ".join(a["verb"] + "()" for a in ast["actions"]))
    print("  ⇒ mode    : %s" % tier)
    if snapshot:
        print("              + flight recorder armed (snapshot)")
    print("  bytecode  : %s" % os.path.relpath(obj, HERE))
    if ran:
        print("  verify    : PREVAIL → %s" % ("\033[32mPASS (loadable)\033[0m" if ok
                                              else "\033[31mREJECTED (fail-closed, not loaded)\033[0m"))
    else:
        print("  verify    : (skipped — set LS_VERIFIER or build ../ebpf-verifier)")
    which = "minimm-ubpf" if mode == "filter" else "minimm-trace"
    env = "LS_SHIELD_OBJ=%s%s" % (os.path.relpath(obj, HERE),
                                  " LS_FLIGHTREC=1" if (snapshot and mode == "filter") else "")
    modeset = "  &&  minimm ctl mode enforce" if mode == "filter" else ""
    print("  run it    : %s %s relay ...%s" % (env, which, modeset))
    if show_c:
        print("── generated shield (%s) ─────────────────────────────" % os.path.relpath(csrc, HERE))
        with open(csrc) as fh:
            for ln in fh:
                if ln.startswith("/*") or ln.startswith(" *"):
                    continue
                print("  " + ln.rstrip())
    return ast, mode, snapshot, obj, (ran, ok)


# --------------------------------------------------------------------------- #
# run (drive minimm end to end)                                                #
# --------------------------------------------------------------------------- #

RP, EP = 18080, 19090
SHM = "/dev/shm/minimm_ls"


def _send(op, payload, port=RP):
    frame = struct.pack(">HH", op, len(payload)) + (payload.encode() if isinstance(payload, str) else payload)
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1.5)
    try:
        s.connect(("127.0.0.1", port))
        s.sendall(frame)
        try:
            s.recv(1024)
        except socket.timeout:
            pass
        return True
    except OSError:
        return False
    finally:
        s.close()


def _wait_port(port, tries=50):
    for _ in range(tries):
        try:
            socket.create_connection(("127.0.0.1", port), 0.1).close()
            return True
        except OSError:
            time.sleep(0.1)
    return False


def _ctl(binary, *args):
    return subprocess.run([binary, "ctl", *args], capture_output=True, text=True).stdout.strip()


def _trigger_frame(pred):
    """Craft one frame that satisfies the predicate (best effort)."""
    if not pred:
        return 0x4242, "trigger"
    f, op, c = pred["field"], pred["op"], pred["const"]
    pick = {">=": c, ">": c + 1, "==": c, "!=": c ^ 1, "<": max(c - 1, 0), "<=": c}[op]
    if f == "opcode":
        return pick & 0xffff, "trigger"
    if f in ("payload_len", "avail_len"):
        return 0x4242, "A" * min(max(pick, 0), 1400)   # OOB opcode + sized payload
    return 0x4242, "trigger"


def cmd_run(oneliner):
    ast, mode, snapshot, obj, _ = cmd_compile(oneliner, show_c=False)
    ran, ok = verify(obj)
    if ran and not ok:
        print("\n  \033[31mshield REJECTED by verifier — not loading (fail closed)\033[0m")
        return 1

    binary = MM_UBPF if mode == "filter" else MM_TRACE
    if not os.access(binary, os.X_OK):
        print("\n  backend missing: %s  (run: make -C minimm ubpf)" % binary)
        return 1

    env = dict(os.environ, LS_SHIELD_OBJ=obj)
    if snapshot and mode == "filter":
        env["LS_FLIGHTREC"] = "1"
    v = find_verifier()
    if v:
        env["LS_VERIFIER"], env["LS_VERIFY_SECTION"] = v, ".text"

    procs = []
    try:
        if os.path.exists(SHM):
            os.remove(SHM)
        echo = subprocess.Popen([binary, "echo", "--listen", str(EP)],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        procs.append(echo)
        _wait_port(EP)
        rlog = open(os.path.join(GEN, "relay.log"), "w+")
        relay = subprocess.Popen([binary, "relay", "--listen", str(RP),
                                  "--upstream", "127.0.0.1:%d" % EP],
                                 stdout=rlog, stderr=subprocess.STDOUT, env=env)
        procs.append(relay)
        if not _wait_port(RP):
            rlog.seek(0)
            print("\n  relay failed to start:\n" + rlog.read())
            return 1

        print("\n── tmmtrace run ──────────────────────────────────────────────")
        if mode == "filter":
            print("  " + _ctl(binary, "mode", "enforce"))
        print("  loaded %s into %s at hook ls_request_eval_decision" %
              (os.path.relpath(obj, HERE), os.path.basename(binary)))

        # run-up traffic, then the trigger
        print("  → run-up: benign frames op=0..3")
        for op in (1, 2, 3, 0):
            _send(op, "runup")
        top, tpay = _trigger_frame(ast["pred"])
        print("  → trigger: opcode=0x%04x payload_len=%d" % (top, len(tpay)))
        _send(top, tpay)
        time.sleep(0.35)

        alive = relay.poll() is None
        if mode == "filter":
            verdict = "\033[32mALIVE — shield held (attack dropped)\033[0m" if alive \
                else "\033[31mDEAD (unexpected for enforce)\033[0m"
        else:
            verdict = "\033[32mALIVE\033[0m" if alive else \
                "\033[33mDEAD — observe never blocks; the recorder captured the run-up first\033[0m"
        print("  data plane : %s" % verdict)

        print("  " + _ctl(binary, "stats"))
        if snapshot or mode == "observe":
            rlog.seek(0)
            dump = [l for l in rlog.read().splitlines() if "FLIGHT RECORDER" in l or "t-" in l]
            if dump:
                print("  flight recorder (run-up into the trigger):")
                for l in dump[:12]:
                    print("    " + l.split("] ", 1)[-1] if "] " in l else "    " + l)
            fr = _ctl(binary, "flightrec")
            if fr:
                print("  post-mortem (survives the crash, from shm):")
                for l in fr.splitlines():
                    print("    " + l)
        return 0
    finally:
        for p in procs:
            p.terminate()
        for p in procs:
            try:
                p.wait(1)
            except Exception:
                p.kill()
        if os.path.exists(SHM):
            os.remove(SHM)


# --------------------------------------------------------------------------- #

def main():
    ap = argparse.ArgumentParser(prog="tmmtrace",
                                 description="bpftrace-style front-end to TMM's embedded eBPF VM (prototype)")
    sub = ap.add_subparsers(dest="cmd")

    pl = sub.add_parser("list", help="list probes from the hook-point map")
    pl.add_argument("pattern", nargs="?", default="")

    pc = sub.add_parser("compile", help="compile a one-liner to a (verified) shield")
    pc.add_argument("oneliner")

    pr = sub.add_parser("run", help="compile then drive minimm end to end")
    pr.add_argument("oneliner")

    # convenience flags:  tmmtrace -l   /   tmmtrace -e 'ONELINER'
    ap.add_argument("-l", "--list", nargs="?", const="", metavar="PAT")
    ap.add_argument("-e", "--exec", metavar="ONELINER")
    args = ap.parse_args()

    try:
        if args.cmd == "list" or args.list is not None:
            return cmd_list(args.pattern if args.cmd == "list" else args.list) or 0
        if args.exec:
            return cmd_run(args.exec) or 0
        if args.cmd == "compile":
            cmd_compile(args.oneliner)
            return 0
        if args.cmd == "run":
            return cmd_run(args.oneliner) or 0
        ap.print_help()
        return 2
    except (ParseError, FileNotFoundError) as e:
        print("tmmtrace: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
